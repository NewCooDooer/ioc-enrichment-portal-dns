# Copy to .env (gitignored) to override defaults. No secrets are needed in this version:
# all sources are keyless. Never commit a real .env.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8010
FRONTEND_PORT=8510
BACKEND_URL=http://127.0.0.1:8010

# Optional timeouts (seconds). crt.sh is slow, so it has its own.
# SOURCE_TIMEOUT_SECONDS=10
# CRTSH_TIMEOUT_SECONDS=25

# Test hooks: make a source fail on purpose. The defaults are the real services; leave these unset normally.
# CRTSH_URL=http://127.0.0.1:9/
# RDAP_URL=https://rdap.org
# DOH_URL=https://dns.google/resolve
